{
  "multipart": [
    { "when": { "north": "disabled" }, "apply": { "model": "copperpipes:block/copper_pipe_cap" } },
    { "when": { "east": "disabled" }, "apply": { "model": "copperpipes:block/copper_pipe_cap", "y": 90 } },
    { "when": { "south": "disabled" }, "apply": { "model": "copperpipes:block/copper_pipe_cap", "y": 180 } },
    { "when": { "west": "disabled" }, "apply": { "model": "copperpipes:block/copper_pipe_cap", "y": 270 } },
    { "when": { "up": "disabled" }, "apply": { "model": "copperpipes:block/copper_pipe_cap", "x": 270 } },
    { "when": { "down": "disabled" }, "apply": { "model": "copperpipes:block/copper_pipe_cap", "x": 90 } },
    { "when": { "facing": "north" }, "apply": { "model": "copperpipes:block/outlet_connector" } },
    { "when": { "facing": "north", "south": "false|disabled" }, "apply": { "model": "copperpipes:block/copper_pipe_side", "y": 180 } },
    { "when": { "facing": "east" }, "apply": { "model": "copperpipes:block/outlet_connector", "y": 90 } },
    { "when": { "facing": "east", "west": "false|disabled" }, "apply": { "model": "copperpipes:block/copper_pipe_side", "y": 270 } },
    { "when": { "facing": "south" }, "apply": { "model": "copperpipes:block/outlet_connector", "y": 180 } },
    { "when": { "facing": "south", "north": "false|disabled" }, "apply": { "model": "copperpipes:block/copper_pipe_side" } },
    { "when": { "facing": "west" }, "apply": { "model": "copperpipes:block/outlet_connector", "y": 270 } },
    { "when": { "facing": "west", "east": "false|disabled" }, "apply": { "model": "copperpipes:block/copper_pipe_side", "y": 90 } },
    { "when": { "facing": "up" }, "apply": { "model": "copperpipes:block/outlet_connector", "x": 270 } },
    { "when": { "facing": "up", "down": "false|disabled" }, "apply": { "model": "copperpipes:block/copper_pipe_side", "x": 90 } },
    { "when": { "facing": "down" }, "apply": { "model": "copperpipes:block/outlet_connector", "x": 90 } },
    { "when": { "facing": "down", "up": "false|disabled" }, "apply": { "model": "copperpipes:block/copper_pipe_side", "x": 270 } },
    { "when": { "north": "true" }, "apply": { "model": "copperpipes:block/copper_pipe_arm" } },
    { "when": { "east": "true" }, "apply": { "model": "copperpipes:block/copper_pipe_arm", "y": 90 } },
    { "when": { "south": "true" }, "apply": { "model": "copperpipes:block/copper_pipe_arm", "y": 180 } },
    { "when": { "west": "true" }, "apply": { "model": "copperpipes:block/copper_pipe_arm", "y": 270 } },
    { "when": { "up": "true" }, "apply": { "model": "copperpipes:block/copper_pipe_arm", "x": 270 } },
    { "when": { "down": "true" }, "apply": { "model": "copperpipes:block/copper_pipe_arm", "x": 90 } }
  ]
}
